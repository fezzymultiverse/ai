{
  "name": "horizon",
  "version": "1.93.14",
  "private": true,
  "description": "Horizon Bojack Security",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/local-notifications": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "playwright": "1.65.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.smoke.cjs",
    "test:voice-dsp": "node tests/voice-dsp.cjs",
    "test:voice-browser": "node tests/voice-studio.browser.cjs",
    "postinstall": "node scripts/patch-cli-tar.cjs",
    "test:closed-feature": "node tests/closed-feature.browser.cjs",
    "test:deepscan-browser": "node tests/deepscan.browser.cjs",
    "test:keyboard-browser": "node tests/recipient-keyboard.browser.cjs",
    "test:approval-browser": "node tests/requested-fixes.browser.cjs",
    "test:all": "npm test && npm run test:voice-dsp && npm run test:browser && npm run test:voice-browser && npm run test:closed-feature && npm run test:keyboard-browser && npm run test:approval-browser && npm run test:deepscan-browser",
    "test:live-public": "node tests/public-live.cjs && node tests/public-live.browser.cjs"
  },
  "overrides": {
    "tar": "7.5.22",
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  }
}
