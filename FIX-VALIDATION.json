  "fixes": [
    {
      "request": 1,
      "result": "thoughtAnalyse checks DOM hidden ancestors, layout boxes and CSS visibility; music and YouTube visibility is separate from enabled AI controls; web reports availability rather than claiming use."
    },
    {
      "request": 2,
      "result": "Opt-in Proactive check-in in the existing Proactive Daemon settings card; selectable 1/2/4/8/12/24-hour WorkManager intervals; network/battery constraints; notifications only; selected-provider credentials and at most 12 text excerpts of 600 characters encrypted using Android Keystore AES-GCM. Snapshot refreshes while app is open and expires after seven days. Disable cancels work and removes snapshot. All existing provider request protocols are preserved, including Gonka Anthropic Messages and AnyAPI/Routeway :free-only models."
    },
    {
      "request": 3,
      "result": "Download tray X stops parent event propagation and removes finished/queued/running rows. Running transfers are dismissed, not cancelled, and keep their concurrency slot until completion. Separate download history continues updating."
    },
    {
      "request": 4,
      "result": "Existing RemoteInput path reused for background replies, now also respecting silent mode in the inbox. PendingIntent creator package validated. Unspecified contact routing uses captured Personal/Business identity and refuses ambiguity. Contacts has Automatic/Personal/Business routing. Package-pinned fallback helper checks installed/enabled source; no account guessing."
    },
    {
      "request": 5,
      "result": "Existing private notification inbox retained and repaired rather than duplicated. It supports read/reply/refresh, indicates expired reply actions, and offers eligible accessibility fallback. This is a captured-preview inbox, not WhatsApp history access."
    },
    {
      "request": 6,
      "result": "Reply text and caret are white on #075E54 with readable placeholder. Native notification previews are dispatched before the persistence queue. Background status notifications are filtered, and notification history tails are not replayed as a toast burst. No network/AI request blocks that path."
    },
    {
      "request": 7,
      "result": "Optional AccessibilityService, restricted to the two WhatsApp packages and a single approved direct-contact send. Separate Android permission and per-send confirmation required. Verifies recipient header and exact composer text, refuses existing drafts, expires after 20 seconds, and attempts Send at most once. No PiP coercion; visible app opening is disclosed."
    },
    {
      "request": 8,
      "result": "Horizon-owned native Termux command confirmation replaced by a neon HTML dialog with plain-text command/warnings and Cancel/Run. Native-generated one-shot token binds approval to the original command closure; expires after two minutes; cancel-on-background and native lock/permission/enable checks remain. Existing explicit auto-run settings preserved. Android OS permission prompts are not replaced."
    },
    {
      "request": 9,
      "result": "Targeted security review: validate WhatsApp PendingIntent creator/package, pin deep-link packages, gate inbox configure/clear under app lock, protect AccessibilityService with system bind permission, retain non-exported result receiver, bound and clean up accessibility requests/nodes/callbacks, render new external text with textContent, use native expiring Termux approval tokens, quote native event names, reject credential-bearing/nonstandard-port native AI URLs and retain no-redirect behavior, encrypt and exclude background credentials from backup."
    }
  ],
  "on_device_validation_required": [
    "RemoteInput submission and Personal/Business routing with actual installed WhatsApp versions; submissions are never claimed delivered.",
    "Android notification/accessibility permission flows, OEM background restrictions and screen-lock behavior.",
    "Accessibility view IDs and recipient-header layout differ between WhatsApp versions. A mismatch times out/refuses rather than guessing; it is not a guarantee of compatibility.",
    "WorkManager intervals are approximate and may be delayed by Doze/battery/network restrictions. Android force-stop pauses work until the app is reopened. No live provider requests or real WhatsApp messages were sent during tests.",
    "The Termux HTML dialog replaces app-level confirmation only. Android retains its own required permission prompts.",
    "The security review is scoped to these changes and inspected boundaries; this is not a full penetration test or a guarantee of no remaining vulnerabilities."
  ],
